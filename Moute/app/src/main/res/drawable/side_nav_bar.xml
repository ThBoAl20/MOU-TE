<!-- Fondo de interfaz @drawable/side_nav_bar.
     Sus elementos (gradient) definen la apariencia; la interacción la implementa la vista que lo usa. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:centerColor="#009688"
        android:endColor="#00695C"
        android:startColor="#4DB6AC"
        android:type="linear" />
</shape>
