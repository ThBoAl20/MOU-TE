<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de interfaz @drawable/text_views.
     Sus elementos (corners,solid,stroke) definen la apariencia; la interacción la implementa la vista que lo usa. -->
<shape android:shape="rectangle" xmlns:android="http://schemas.android.com/apk/res/android">
    <corners android:bottomLeftRadius="200dp" android:bottomRightRadius="200dp"/>
    <solid android:color="#A9A5A5"/>
    <stroke android:color="#000000" android:width="1dp"/>
</shape>
