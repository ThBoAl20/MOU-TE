<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla inicial usada por la actividad SplashScreen, antes de abrir MainActivity.
     Las animaciones y la transición temporal se coordinan desde la actividad. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".SplashScreen">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="357dp"
        android:layout_height="373dp"
        android:foregroundGravity="center"
        android:transitionName="logo_img"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.243"
        app:srcCompat="@drawable/applogo" />

    <TextView
        android:id="@+id/lblSloganLogo"
        android:layout_width="305dp"
        android:layout_height="127dp"
        android:fontFamily="@font/aldrich"
        android:gravity="center"
        android:text="Contrata rápido y fácil"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.761" />

</androidx.constraintlayout.widget.ConstraintLayout>
