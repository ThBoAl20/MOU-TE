<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo de confirmación usado desde VerTarjetaFragment.
     La acción efectiva depende de la rama Java; el diseño por sí solo no elimina datos. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:background="@drawable/layout_drawable"
    android:orientation="vertical"
    android:gravity="center">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:fontFamily="sans-serif-light"
            android:text="¿Eliminar tarjeta?"
            android:textColor="#0C0C0C"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:fontFamily="sans-serif-light"
            android:text="@string/delete_card_info"
            android:textColor="#000000"
            android:textSize="16sp" />
    </LinearLayout>
    
    <View
        android:layout_width="match_parent"
        android:layout_height="0.7dp"
        android:alpha="0.8"
        android:background="#000000"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="172dp"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:fontFamily="sans-serif-light"
            android:text="Eliminar"
            android:textAllCaps="false"
            android:textColor="#FF0000"
            android:textFontWeight="1"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0.7dp"
            android:layout_height="match_parent"
            android:alpha="0.8"
            android:background="#000000" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="181dp"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:fontFamily="sans-serif-light"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textFontWeight="1"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
