<?xml version="1.0" encoding="utf-8"?>
<!-- Formulario de LoginFragment para autenticar correo y contraseña mediante Firebase Auth.
     Los enlaces llevan al registro o a la recuperación de contraseña. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/loginbackgroud"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".ui.LoginFragment"
    android:transitionName="go_to_login">

    <ImageView
        android:id="@+id/img_logo_login"
        android:layout_width="122dp"
        android:layout_height="122dp"
        android:layout_gravity="left"
        android:padding="20dp"
        android:src="@drawable/applogo2"
        android:transitionName="logo_img" />

    <TextView
        android:id="@+id/txtWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:layout_marginLeft="15dp"
        android:fontFamily="sans-serif-light"
        android:gravity="center|left"
        android:text="Bienvenido"
        android:textColor="#000000"
        android:textSize="36sp"
        android:textStyle="bold"
        android:transitionName="slogan_text" />

    <TextView
        android:id="@+id/textView20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:layout_marginLeft="15dp"
        android:layout_marginBottom="15dp"
        android:fontFamily="sans-serif-light"
        android:text="Inicia sesión para continuar"
        android:textColor="#000000"
        android:textSize="18sp"
        android:transitionName="slogan_text" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/txtEmailLogin"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="7dp"
        app:boxStrokeColor="@color/colorDark"
        app:boxStrokeWidthFocused="2dp"
        app:counterOverflowTextColor="@color/quantum_googredA700"
        app:hintTextColor="@color/colorDark"
        app:startIconDrawable="@drawable/ic_email"
        app:endIconMode="clear_text"
        app:endIconTint="@color/colorDark"
        app:startIconTint="@color/colorDark">

        <com.google.android.material.textfield.TextInputEditText

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-light"
            android:hint="E-mail"
            android:inputType="textEmailAddress"
            android:transitionName="email_text"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/txtPasswordLogin"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="7dp"
        app:boxStrokeColor="@color/colorDark"
        app:boxStrokeWidthFocused="2dp"
        app:counterOverflowTextColor="@color/quantum_googredA700"
        app:hintTextColor="@color/colorDark"
        app:startIconDrawable="@drawable/ic_lock_black_"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/colorDark"
        app:startIconTint="@color/colorDark">

        <com.google.android.material.textfield.TextInputEditText

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-light"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:transitionName="pass_text"/>
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="30dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDoLogin"
            android:layout_width="164dp"
            android:layout_height="53dp"
            android:layout_gravity="left"
            android:layout_marginRight="5dp"
            android:background="@drawable/button"
            android:fontFamily="sans-serif-light"
            android:text="Iniciar Sesión"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:transitionName="btn_login" />

        <Button
            android:id="@+id/bntForgotPass"
            android:layout_width="182dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#00FFFFFF"
            android:fontFamily="sans-serif-light"
            android:text="¿Has Olvidado tu contraseña?"
            android:transitionName="btn_forgot"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:layout_marginTop="180dp"
        android:layout_marginRight="15dp"
        android:orientation="horizontal"
        android:transitionName="register">

        <TextView
            android:id="@+id/textView14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:layout_marginBottom="32dp"
            android:fontFamily="sans-serif-light"
            android:text="¿No tienes cuenta?"
            android:textColor="#000000"
            android:textSize="14sp"
            android:transitionName="register_text"/>

        <TextView
            android:id="@+id/lblLinkDoRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="36dp"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:text=" Registrate"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:transitionName="register_text"/>

    </LinearLayout>

</LinearLayout>
