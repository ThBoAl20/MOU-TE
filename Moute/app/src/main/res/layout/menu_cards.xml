<?xml version="1.0" encoding="utf-8"?>
<!-- Selector visual heredado de medios de transporte (Metro, Bus y Cercanías).
     No debe confundirse con el catálogo de ContratarFragment. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <CheckBox
        android:id="@+id/chContrato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/exo_thin"
        android:text="Metro"
        android:textColor="#000000"
        android:textSize="24sp"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/chBus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/exo_thin"
        android:text="Bus"
        android:textColor="#000000"
        android:textSize="24sp"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/chTrenCercanias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/exo_thin"
        android:text="Tren de cercanias"
        android:textColor="#000000"
        android:textSize="24sp"
        android:textStyle="bold" />

</LinearLayout>
